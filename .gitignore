node_modules
dist
build
.next
# next.config.js builds production into a separate distDir so a build cannot
# overwrite the running dev server's .next — it is just as much an artifact.
.next-build
out
.env
.env.local
.env.*.local
.env.*
# `.env**` used to sit here, which also matched `.env.example`. The templates
# survived only because they were already tracked — a new app's `.env.example`
# would have been ignored silently. Re-allow them explicitly.
!.env.example
!.env.*.example
*.db
*.db-journal
coverage

# Build artifacts
*.tsbuildinfo

# Logs (foreground log files, not just the logs/ directory)
*.log

# One-off local debug/scratch scripts
apps/backend/check-data.js

# WSL health-check diagnostics (environment-specific output)
tools/windows/scripts/wsl-result*.txt

# Local operational data — never commit school records, logs, or the DB itself
backups/
logs/
.postgres/
uploads/

# Cloud backup target credentials (DPAPI / machine-key encrypted, still secrets)
.cloud-creds/

# Machine binding (anti-copy protection) - created on first run, machine-specific
machine.lock

.vscode
.idea
.DS_Store
Thumbs.db
