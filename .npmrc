# pnpm v10 auto-installs declared optional peers - that pulled drizzle-orm's
# optional @prisma/client / prisma peers into the install (the Prisma driver
# adapter is never used). Our direct deps satisfy every peer this repo needs.
autoInstallPeers=false

# uri-js (via ajv, in the pnpm/next toolchain) requires the legacy built-in
# "punycode"; Node 22+ prints DEP0040 for that. It's harmless toolchain noise -
# suppress deprecation notices for every pnpm-run script.
node-options=--no-deprecation