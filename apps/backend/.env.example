# Backend configuration.
#
# Copy to `apps/backend/.env` and fill in. On Windows the first-run wizard
# (tools\windows\scripts\setup.ps1, invoked by tools\windows\start.bat) writes a
# complete .env for you — generating the secrets, creating the database role and
# recording its password — so this file is only needed for hand-editing or for a
# non-Windows install.
#
# Every key below is read by something. Keys are grouped by what reads them.

# --- Application ------------------------------------------------------------
APP_NAME=school-management-api
NODE_ENV=development
# Port the API listens on. The frontend's NEXT_PUBLIC_API_URL must agree.
PORT=3001

# Shown in the browser tab, login screen and sidebar.
SCHOOL_NAME=School Management System
# Slug form of the school name. The Windows launcher derives the database name
# and role from it, so changing it after setup means renaming both.
SCHOOL_SLUG=school-management-system

# --- Database ---------------------------------------------------------------
# The only one the application itself reads.
DATABASE_URL=postgresql://school_user:change_me@localhost:5432/school_db?schema=public

# The same values, split out. The Windows launcher scripts read these to create
# the database and role, to check the connection before starting, and to run
# backups; keep them consistent with DATABASE_URL.
DATABASE_NAME=school_db
DATABASE_USER=school_user
DATABASE_PASSWORD=change_me

# Password of the `postgres` superuser. Needed only for operations the app role
# is not permitted to perform — creating the database and role on first run, and
# `CREATE EXTENSION pg_trgm` for the search indexes. Never used to serve a
# request.
POSTGRES_SUPERUSER_PASSWORD=change_me

# --- Authentication ---------------------------------------------------------
# Generate both with a CSPRNG, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leaving either unset does not stop the app booting: it generates a random
# secret for that process and logs a warning. Nothing is ever signed with a
# value published in this repository — but every restart then invalidates all
# sessions, so set both on any install you intend to keep.
JWT_SECRET=change_me_generate_a_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_generate_another_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Cost factor for password hashing. Higher is slower and stronger.
BCRYPT_ROUNDS=10

# --- Update checks (in-app "new version" dialog) ----------------------------
# Minutes between checks of the release repository; 0 disables the check.
UPDATE_CHECK_MINUTES=60
# Branch of the release repository this install tracks. Pin every school
# machine to the same value (e.g. selfhosted); without it the install compares
# against its own checked-out branch. The update engine reads this too.
UPDATE_BRANCH=main
# Required if the release repository is private. Create a classic PAT or
# fine-grained token with `Contents: Read` on the repo, then paste it here.
# Public repos do not need this (subject to GitHub's unauthenticated rate limit).
GITHUB_TOKEN=

# --- Seeding ----------------------------------------------------------------
# Credentials for the single super_admin operator created by `db:seed`.
# Override these before seeding anything that is not a local dev database.
SEED_ADMIN_NAME=School Administrator
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_PASSWORD=change_me_password

# --- Dropbox backup (recommended online destination) ------------------------
# The application's own Dropbox app. Set these ONCE in the release build and
# every school connects in one click - no console, no keys, nothing to paste.
#
# Registration is one form and about two minutes:
#   1. developers.dropbox.com/apps -> Create app
#   2. Choose "Scoped access", then "App folder", and name it
#   3. Permissions tab -> tick files.content.write and files.content.read -> Submit
#   4. Settings tab -> add the redirect URI:
#        http://localhost:3000/api/cloud-backup/oauth/dropbox/callback
#      (add one line per port/host a school may use)
#   5. Copy the App key and App secret below
#
# No verification review, no cloud project. "App folder" access means the app
# can only ever see the directory it created - it cannot read the user's
# other files even in principle.
#
# Leave blank to hide Dropbox from the first screen and fall back to asking
# each install for its own app.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# --- Google Drive backup (cloud safe save) ----------------------------------
# The application's own Google OAuth client. Set these ONCE in the release
# build and every school connects Drive with a single "Se connecter avec
# Google" button — no Google Cloud Console, no client id, no secret to paste.
#
# Create it at console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> **Desktop app**. A desktop client
# is designed to be distributed inside an installed application, which is why
# its "secret" is not treated as confidential (RFC 8252 s8.5) - the same
# pattern rclone and the gcloud CLI use.
#
# The backup requests the `drive.file` scope, which can only see files this
# app itself created. Google classifies it as non-sensitive, so no
# verification review is required.
#
# Leave both blank to fall back to asking each install for its own client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- HTTP -------------------------------------------------------------------
# Extra browser origins allowed to call the API with credentials, comma
# separated. Loopback (localhost / 127.0.0.1, any port) is always allowed;
# add an entry here only when the portal is reached over a LAN address.
CORS_ALLOWED_ORIGINS=
# Publish the Swagger UI at /api/docs in production. Off by default: it
# exposes the whole API surface without authentication.
ENABLE_API_DOCS=false
