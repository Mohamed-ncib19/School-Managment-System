APP_NAME=iq-academy-api
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://iq_user:iq_password@localhost:5432/iq_academy?schema=public

JWT_SECRET=iq_academy_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=iq_academy_refresh_secret_change_in_production_2024
JWT_REFRESH_EXPIRES_IN=30d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

BCRYPT_ROUNDS=10

# Seed credentials for the single super_admin operator.
# Override these before seeding anything that isn't a local dev database.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@iqacademy.com
SEED_ADMIN_PASSWORD=admin123
