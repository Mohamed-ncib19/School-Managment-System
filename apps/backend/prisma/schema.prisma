generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                  String             @id @default(uuid()) @db.Uuid
  full_name           String
  email               String             @unique
  password_hash       String
  role                UserRole           @default(super_admin)
  is_active           Boolean            @default(true)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  reset_token         String?
  reset_token_expires DateTime?
  audit_logs          audit_logs[]       @relation("AuditActor")
  created_fields      fields[]           @relation("FieldCreator")
  professors          professors[]
  recorded_payments   student_payments[]
  recorded_txns       payment_transactions[] @relation("TransactionRecorder")
  recorded_payroll    payroll_payments[]     @relation("PayrollRecorder")
  generated_documents payroll_documents[]    @relation("PayrollDocumentGenerator")

  @@map("users")
}

/// Root of the academic hierarchy: level > field > professor > group > student.
///
/// A level is school-wide ("Beginner", "Terminale"), not per-professor: the same
/// level is taught by many professors across many fields, and every roll-up on
/// the dashboard starts here.
model levels {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  color      String?
  created_at DateTime @default(now())
  is_active  Boolean  @default(true)
  fields     fields[] @relation("LevelFields")

  @@map("levels")
}

model fields {
  id          String       @id @default(uuid()) @db.Uuid
  level_id    String       @db.Uuid
  name        String
  description String?
  color       String?
  created_by  String       @db.Uuid
  created_at  DateTime     @default(now())
  is_active   Boolean      @default(true)
  creator     users        @relation("FieldCreator", fields: [created_by], references: [id])
  level       levels       @relation("LevelFields", fields: [level_id], references: [id])
  professors  professors[] @relation("FieldProfessors")

  @@index([created_by])
  @@index([level_id])
  @@index([is_active])
  @@map("fields")
}

/// Scoped to one field, and therefore to one level. A teacher who takes two
/// levels holds one row per level - the row is the teaching assignment, and the
/// groups hanging off it are the classes for that level.
model professors {
  id         String   @id @default(uuid()) @db.Uuid
  field_id   String   @db.Uuid
  full_name  String
  phone      String
  email      String?
  color      String?
  user_id    String?  @db.Uuid
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  groups     groups[] @relation("ProfessorGroups")
  field      fields   @relation("FieldProfessors", fields: [field_id], references: [id])
  user       users?   @relation(fields: [user_id], references: [id])

  compensation professor_compensations? @relation("ProfessorCompensation")
  transactions payment_transactions[]   @relation("ProfessorTransactions")
  payroll      payroll_payments[]       @relation("ProfessorPayroll")

  @@index([field_id])
  @@index([is_active])
  @@map("professors")
}

model groups {
  id             String     @id @default(uuid()) @db.Uuid
  prof_id        String     @db.Uuid
  name           String
  capacity       Int?
  schedule_notes String?
  color          String?
  created_at     DateTime   @default(now())
  is_active      Boolean    @default(true)
  professor      professors @relation("ProfessorGroups", fields: [prof_id], references: [id])
  students       students[] @relation("GroupStudents")
  assignments    student_assignments[] @relation("GroupAssignments")
  payments       student_payments[] @relation("PaymentGroups")
  attendanceSheets attendance_sheets[] @relation("GroupAttendanceSheets")

  @@index([prof_id])
  @@map("groups")
}

model students {
  id              String             @id @default(uuid()) @db.Uuid
  /// Primary group for billing and roll-ups; every enrollment is also in
  /// `assignments`, which may include groups from other fields/levels.
  group_id        String             @db.Uuid
  first_name      String
  last_name       String
  phone           String
  parent_phone    String?
  email           String?
  color           String?
  enrollment_date DateTime
  monthly_fee     Decimal            @db.Decimal(10, 2)
  status          StudentStatus      @default(active)
  created_at      DateTime           @default(now())
  payments        student_payments[] @relation("StudentPayments")
  group           groups             @relation("GroupStudents", fields: [group_id], references: [id])
  assignments     student_assignments[] @relation("StudentAssignments")

  @@index([group_id])
  @@index([status])
  @@index([last_name, first_name])
  @@map("students")
}

/// A student can be enrolled in several groups (e.g. two fields of the same
/// level); each row is one enrollment. `students.group_id` is the primary one,
/// used for dashboard roll-ups. `fee` is what this enrollment costs per month:
/// billing raises one invoice per enrollment, so a student in two fields is
/// billed twice.
model student_assignments {
  id         String   @id @default(uuid()) @db.Uuid
  student_id String   @db.Uuid
  group_id   String   @db.Uuid
  fee        Decimal  @default(0) @db.Decimal(10, 2)
  created_at DateTime @default(now())
  student    students @relation("StudentAssignments", fields: [student_id], references: [id], onDelete: Cascade)
  group      groups   @relation("GroupAssignments", fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([student_id, group_id])
  @@index([group_id])
  @@map("student_assignments")
}

model student_payments {
  id             String         @id @default(uuid()) @db.Uuid
  student_id     String         @db.Uuid
  /// The enrollment this invoice covers. One invoice per student per group per
  /// period: a student in two fields gets two invoices each month, each at the
  /// fee of its own assignment.
  group_id       String         @db.Uuid
  period         String
  amount_due     Decimal        @db.Decimal(10, 2)
  due_date       DateTime
  status         PaymentStatus  @default(not_paid)
  paid_amount    Decimal?       @db.Decimal(10, 2)
  paid_at        DateTime?
  recorded_by    String?        @db.Uuid
  payment_method PaymentMethod?
  notes          String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  recorder       users?         @relation(fields: [recorded_by], references: [id])
  student        students       @relation("StudentPayments", fields: [student_id], references: [id])
  group          groups         @relation("PaymentGroups", fields: [group_id], references: [id])
  transactions   payment_transactions[] @relation("PaymentTransactions")

  @@unique([student_id, group_id, period])
  @@index([group_id])
  @@index([status])
  @@index([due_date])
  @@index([period])
  @@index([status, due_date])
  @@index([period, status])
  @@map("student_payments")
}

/// One movement of money against a student's monthly invoice.
///
/// `student_payments` is the invoice - what is owed for a period. This table is
/// the ledger of what actually changed hands against it, which is what makes
/// partial payments, several instalments in one month, refunds and corrections
/// expressible without ever mutating history. `student_payments.paid_amount` is
/// kept as the running total of these rows so list and dashboard queries do not
/// have to aggregate the ledger.
///
/// `amount` is signed: a payment is positive, a refund negative. Summing the
/// column for a period therefore gives the net collected with no case analysis.
///
/// The professor/school split is *snapshotted* here rather than recomputed on
/// read. A percentage change must not silently restate what a professor earned
/// last month - money already apportioned stays apportioned, and the formula
/// that produced it is kept alongside in `compensation_snapshot` so any figure
/// can be explained months later.
model payment_transactions {
  id                    String          @id @default(uuid()) @db.Uuid
  payment_id            String          @db.Uuid
  type                  TransactionType @default(payment)
  /// Positive for payments, negative for refunds. Never zero.
  amount                Decimal         @db.Decimal(10, 2)
  method                PaymentMethod   @default(cash)
  receipt_number        String?         @unique
  paid_at               DateTime        @default(now())
  recorded_by           String?         @db.Uuid
  notes                 String?
  /// Why a refund or correction was issued - required for those two types.
  reason                String?
  professor_share       Decimal         @db.Decimal(10, 2)
  school_share          Decimal         @db.Decimal(10, 2)
  compensation_model    CompensationModel
  /// The full formula input that produced the split above.
  compensation_snapshot Json?
  /// Denormalised from the invoice's student so payroll and revenue roll-ups
  /// never have to walk student -> group -> professor on every row.
  prof_id               String?         @db.Uuid
  period                String
  created_at            DateTime        @default(now())
  payment               student_payments @relation("PaymentTransactions", fields: [payment_id], references: [id], onDelete: Cascade)
  recorder              users?           @relation("TransactionRecorder", fields: [recorded_by], references: [id])
  professor             professors?      @relation("ProfessorTransactions", fields: [prof_id], references: [id])

  @@index([payment_id])
  @@index([prof_id])
  @@index([period])
  @@index([paid_at])
  @@index([prof_id, period])
  @@index([type])
  @@map("payment_transactions")
}

/// Per-professor override of the global revenue split.
///
/// A professor with no row here falls back to the academy default in
/// `financial_settings`. One row per professor: history lives in the audit log
/// and in the snapshots on each transaction, so this table only ever holds the
/// arrangement in force right now.
model professor_compensations {
  id             String            @id @default(uuid()) @db.Uuid
  prof_id        String            @unique @db.Uuid
  model          CompensationModel @default(percentage)
  /// 0-100. Used by `percentage` and `hybrid`.
  percentage     Decimal?          @db.Decimal(5, 2)
  /// Meaning depends on `model`: monthly salary, per-student rate, per-group
  /// rate, or the fixed leg of a hybrid arrangement.
  fixed_amount   Decimal?          @db.Decimal(10, 2)
  /// Escape hatch for arrangements the enum models cannot express. Evaluated by
  /// RevenueCalculationService against a whitelisted variable set.
  custom_formula String?
  effective_from DateTime          @default(now())
  notes          String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  professor      professors        @relation("ProfessorCompensation", fields: [prof_id], references: [id], onDelete: Cascade)

  @@map("professor_compensations")
}

/// Money actually handed to a professor.
///
/// Deliberately *not* a per-period status row. What a professor has earned is
/// derived by summing `payment_transactions.professor_share`; what they have
/// been paid is the sum of these rows. Outstanding balance is the difference,
/// so the two figures can never drift apart the way a stored status would.
/// Unpaid / partial / paid is computed from that comparison, never persisted.
model payroll_payments {
  id             String        @id @default(uuid()) @db.Uuid
  prof_id        String        @db.Uuid
  /// The earnings period this payout settles, or null for a lump sum covering
  /// whatever was outstanding at the time.
  period         String?
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(cash)
  receipt_number String?       @unique
  paid_at        DateTime      @default(now())
  notes          String?
  recorded_by    String?       @db.Uuid
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  professor      professors    @relation("ProfessorPayroll", fields: [prof_id], references: [id], onDelete: Cascade)
  recorder       users?        @relation("PayrollRecorder", fields: [recorded_by], references: [id])
  documents      payroll_documents[] @relation("PayrollDocuments")

  @@index([prof_id])
  @@index([period])
  @@index([paid_at])
  @@index([prof_id, period])
  @@map("payroll_payments")
}

/// Printable settlement documents generated with every payroll payment.
///
/// Two per payout: the professor's own payment receipt, and the school's
/// internal settlement report. `data` is a frozen snapshot of every figure the
/// template was rendered from, so a reprint years later shows exactly what was
/// settled that day — never a recomputation under a rule that changed since.
model payroll_documents {
  id           String               @id @default(uuid()) @db.Uuid
  payout_id    String               @db.Uuid
  type         PayrollDocumentType
  /// The human-readable number printed on the document (the payout's receipt
  /// number for the professor copy, a settlement sequence for the school's).
  document_no  String
  title        String
  period       String?
  generated_by String?              @db.Uuid
  generated_at DateTime             @default(now())
  /// Frozen snapshot of the settlement: professor, academy, formula, totals,
  /// group breakdown, verification result.
  data         Json
  payout       payroll_payments     @relation("PayrollDocuments", fields: [payout_id], references: [id], onDelete: Cascade)
  generator    users?               @relation("PayrollDocumentGenerator", fields: [generated_by], references: [id])

  @@index([payout_id])
  @@index([period])
  @@map("payroll_documents")
}

/// Academy-wide financial configuration. Exactly one row, guarded by `singleton`.
model financial_settings {
  /// Always "global" - a CHECK constraint makes a second row impossible.
  singleton                    String            @id @default("global")
  /// Printed on settlement documents and receipts.
  academy_name                 String            @default("School Management System")
  academy_address              String            @default("")
  academy_phone                String            @default("")
  /// Path of the uploaded academy logo, served by the branding routes.
  logo_path                    String?
  currency                     String            @default("TND")
  currency_locale              String            @default("fr-TN")
  default_compensation_model   CompensationModel @default(percentage)
  /// 0-100. The academy keeps the remainder.
  default_professor_percentage Decimal           @default(60) @db.Decimal(5, 2)
  default_fixed_amount         Decimal?          @db.Decimal(10, 2)
  /// Tokens: {YYYY} {YY} {MM} {SEQ} - see ReceiptNumberService.
  receipt_number_format        String            @default("REC-{YYYY}-{SEQ}")
  payroll_receipt_format       String            @default("PAY-{YYYY}-{SEQ}")
  /// Reference numbers on the school's internal settlement reports.
  settlement_receipt_format    String            @default("SET-{YYYY}-{SEQ}")
  /// How many days before the due date a bill starts showing as "due soon".
  due_soon_days                Int               @default(2)
  /// Days past the due date before a bill counts as late.
  late_grace_days              Int               @default(0)
  late_fee_enabled             Boolean           @default(false)
  late_fee_amount              Decimal?          @db.Decimal(10, 2)
  /// 1-12. September (9) means the 2026/27 year runs Sep 2026 - Aug 2027.
  academic_year_start_month    Int               @default(9)
  created_at                   DateTime          @default(now())
  updated_at                   DateTime          @updatedAt

  @@map("financial_settings")
}

/// Monotonic counters behind human-readable receipt numbers.
///
/// A separate row per scope ("payment:2026") so the sequence restarts each year
/// without a scan, and so payment and payroll numbering never interleave.
/// Incremented inside the same transaction that writes the receipt, which is
/// what stops two concurrent collections from being handed the same number.
model receipt_counters {
  scope      String   @id
  value      Int      @default(0)
  updated_at DateTime @updatedAt

  @@map("receipt_counters")
}

/// Append-only administrative audit trail.
///
/// `actor_user_id` and `entity_id` are nullable on purpose: a failed login has
/// no authenticated actor, and events like "logout" or a settings change have
/// no entity row to point at. They used to be required, which made the audit
/// service throw on exactly those events.
///
/// The actor relation is `SetNull`, never `Cascade`: removing a user must not
/// erase the record of what that user did.
model audit_logs {
  id            String   @id @default(uuid()) @db.Uuid
  actor_user_id String?  @db.Uuid
  actor_label   String?
  actor_role    String?
  action        String
  entity_type   String
  entity_id     String?  @db.Uuid
  entity_label  String?
  prev_values   Json?
  new_values    Json?
  ip_address    String?
  user_agent    String?
  meta          Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  actor         users?   @relation("AuditActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@index([actor_user_id])
  @@index([action])
  @@index([action, created_at])
  @@map("audit_logs")
}

enum UserRole {
  super_admin
}

enum StudentStatus {
  active
  paused
  withdrawn
}

enum PaymentMethod {
  cash
}

/// Which printable settlement document a `payroll_documents` row is.
enum PayrollDocumentType {
  professor_receipt
  school_settlement
}

/// `not_paid` is the "pending" state the UI shows; `due_soon` is a nudge applied
/// as the due date approaches. `partially_paid` means the ledger holds less than
/// `amount_due`, and `cancelled` voids an invoice without deleting it.
enum PaymentStatus {
  not_paid
  due_soon
  overdue
  paid
  partially_paid
  cancelled
}

/// `correction` adjusts a mis-keyed amount and carries a reason; `refund` gives
/// money back. Both are recorded as new signed rows rather than edits, so the
/// ledger stays append-only and every figure remains reconstructable.
enum TransactionType {
  payment
  refund
  correction
}

/// How a professor's cut of a student payment is worked out.
///
/// Everything after `percentage` exists so the arrangement can change without a
/// schema migration: RevenueCalculationService switches on this value and the
/// rest of the system only ever consumes the resulting split.
enum CompensationModel {
  percentage
  fixed_salary
  fixed_per_student
  fixed_per_group
  hybrid
  custom
}

/// Stores configurable hierarchy navigation order.
/// Only one configuration should have `is_active = true` at any time.
model hierarchy_configurations {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  entityOrder Json     // ["level", "field", "professor", "group", "student"]
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hierarchy_configurations")
}

/// School-wide system configuration. Exactly one row, guarded by `singleton`.
///
/// `system_name` is the academy's name as shown in the browser tab, the login
/// screen and the sidebar. `features` is a map of module toggles (fields,
/// levels, students, professors, groups, attendance, financial.*, import,
/// audit, backups) that lets each school hide the parts of the product it
/// does not use, so the same build serves differently-shaped academies.
model system_settings {
  /// Always "global" - a CHECK constraint makes a second row impossible.
  singleton   String   @id @default("global")
  system_name String   @default("School Management System")
  /// Module toggles: key -> boolean (absent means enabled).
  features    Json     @default("{}")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("system_settings")
}

/// A generated monthly attendance sheet, persisted so it can be reprinted.
///
/// The academic context is snapshotted at generation time (teacher, group,
/// level names and the student roster), because a reprint must show the list
/// that was actually handed out, not whatever the hierarchy looks like today.
model attendance_sheets {
    id           String   @id @default(uuid()) @db.Uuid
    group_id     String   @db.Uuid
    month        Int
    year         Int
    schedule     String?
    teacher_id   String?  @db.Uuid
    teacher_name String
    level_name   String
    field_name   String?
    group_name   String
    /// The academic year the month belongs to, e.g. "2025/26" — snapshotted.
    academic_year String?
    /// The teaching sessions (séances) of the register: [{ id, date }].
    sessions     Json?
    /// The frozen roster handed out — a reprint never reflects later moves.
    students     Json
    generated_by String?  @db.Uuid
    generated_at DateTime @default(now()) @db.Timestamptz(6)
    group        groups   @relation("GroupAttendanceSheets", fields: [group_id], references: [id], onDelete: Cascade)

    @@index([group_id])
    @@index([generated_at])
    @@map("attendance_sheets")
  }
