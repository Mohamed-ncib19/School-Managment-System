# Frontend configuration.
#
# Copy to `apps/frontend/.env.local`. The Windows launcher
# (tools\windows\start.bat) writes this file on first run.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time — never
# put a secret in one.

# Where the browser reaches the API. The backend mounts every route under the
# `api` global prefix, so keep it on the URL. Must match the backend's PORT.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Minutes between in-app update checks. 30 = default, 0 = never poll.
NEXT_PUBLIC_UPDATE_CHECK_MINUTES=30

# Next 14 tries to auto-patch the lockfile with @next/swc-* entries on startup;
# with pnpm it finds no package-lock.json and fails the registry fetch. Disable
# it — the launcher sets this too.
NEXT_IGNORE_INCORRECT_LOCKFILE=1
