{
  "name": "iq-academy-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm -C apps/backend run db:generate",
    "db:push": "pnpm -C apps/backend run db:push",
    "db:migrate": "pnpm -C apps/backend run db:migrate",
    "db:migrate:dev": "pnpm -C apps/backend run db:migrate:dev",
    "db:reset": "pnpm -C apps/backend run db:reset",
    "db:seed": "pnpm -C apps/backend run db:seed",
    "db:studio": "pnpm -C apps/backend run db:studio"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
