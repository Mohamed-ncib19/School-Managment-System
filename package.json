{
  "name": "iq-academy-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "node scripts/dev.mjs",
    "dev:no-warm": "node scripts/dev.mjs --no-warm",
    "dev:warm": "node scripts/prewarm.mjs",
    "lint": "pnpm -r run lint",
    "test": "pnpm -C apps/backend run test",
    "test:watch": "pnpm -C apps/backend run test:watch",
    "test:cov": "pnpm -C apps/backend run test:cov",
    "db:generate": "pnpm -C apps/backend run db:generate",
    "db:push": "pnpm -C apps/backend run db:push",
    "db:seed": "pnpm -C apps/backend run db:seed",
    "db:studio": "pnpm -C apps/backend run db:studio",
    "bench": "node scripts/bench.mjs",
    "verify:scheduling": "node scripts/verify-scheduling.mjs",
    "postinstall": "node scripts/check-builds.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
